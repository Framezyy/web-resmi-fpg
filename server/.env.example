APP_ENV=production
APP_URL=https://example.com
CORS_ALLOWED_ORIGIN=https://example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fpg_properties
DB_USER=root
DB_PASSWORD=

MAIL_MODE=resend
RESEND_API_KEY=re_replace_me
MAIL_FROM="Website FPG <website@example.com>"
CONTACT_MAIL_TO=marketing@example.com

TURNSTILE_SECRET_KEY=replace_me
TURNSTILE_HOSTNAME=example.com
TURNSTILE_ACTION=contact
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_MINUTES=10
